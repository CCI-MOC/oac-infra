{% if diskencryption_mode == "tang" %}
apiVersion: machineconfiguration.openshift.io/v1
kind: MachineConfig
metadata:
  labels:
    machineconfiguration.openshift.io/role: master
  name: 98-master-var-lib-etcd
spec:
  config:
    ignition:
      version: 3.2.0
    storage:
      files:
        - path: /usr/local/bin/etcd-disk.sh
          mode: 0755
          overwrite: true
          contents:
            source: data:text/plain;charset=utf-8;base64,{{ lookup('template', 'etcd-disk.sh.j2') | b64encode }}
    systemd:
      units:
        - name: etcd-disk.service
          enabled: true
          contents: |
            [Unit]
            Description=Set up and unlock this master's etcd disk
            DefaultDependencies=no
            # Tang is reached over the network.
            Wants=network-online.target
            After=network-online.target
            Before=var-lib-etcd.mount kubelet.service

            [Service]
            Type=oneshot
            RemainAfterExit=yes
            ExecStart=/usr/local/bin/etcd-disk.sh

            [Install]
            WantedBy=multi-user.target

        - name: var-lib-etcd.mount
          enabled: true
          contents: |
            [Unit]
            Description=Mount this master's etcd disk on /var/lib/etcd
            DefaultDependencies=no
            Requires=etcd-disk.service
            After=etcd-disk.service
            Before=kubelet.service umount.target
            Conflicts=umount.target

            [Mount]
            What=/dev/mapper/etcd
            Where=/var/lib/etcd
            Type=xfs
            Options=defaults

            [Install]
            WantedBy=multi-user.target
            RequiredBy=kubelet.service
{% else %}
apiVersion: machineconfiguration.openshift.io/v1
kind: MachineConfig
metadata:
  labels:
    machineconfiguration.openshift.io/role: master
  name: 98-master-var-lib-etcd
spec:
  config:
    ignition:
      version: 3.2.0
    systemd:
      units:
        - name: format-etcd.service
          enabled: true
          contents: |
            [Unit]
            Description=Dynamically format unique etcd disk based on hostname
            Before=var-lib-etcd.mount local-fs.target
            DefaultDependencies=no
            ConditionPathExists=!/dev/disk/by-partlabel/etcd

            [Service]
            Type=oneshot
            ExecStart=/bin/bash -c 'HOST=$(hostname); if [[ "$HOST" == *"{{ master1_hostname }}"* ]]; then TARGET="/dev/disk/by-id/wwn-{{ master1_etcd_drive_wwn }}"; elif [[ "$HOST" == *"{{ master2_hostname }}"* ]]; then TARGET="/dev/disk/by-id/wwn-{{ master2_etcd_drive_wwn }}"; elif [[ "$HOST" == *"{{ master3_hostname }}"* ]]; then TARGET="/dev/disk/by-id/wwn-{{ master3_etcd_drive_wwn }}"; else exit 0; fi; sgdisk -Z $TARGET && sgdisk -n 1:0:0 -c 1:etcd $TARGET && udevadm settle && mkfs.xfs -f /dev/disk/by-partlabel/etcd'

            [Install]
            WantedBy=local-fs.target

        - name: var-lib-etcd.mount
          enabled: true
          contents: |
            [Unit]
            Description=Mount separate disk to /var/lib/etcd
            Before=local-fs.target
            After=format-etcd.service
            Requires=format-etcd.service

            [Mount]
            What=/dev/disk/by-partlabel/etcd
            Where=/var/lib/etcd
            Type=xfs
            Options=defaults

            [Install]
            WantedBy=local-fs.target
{% endif %}
