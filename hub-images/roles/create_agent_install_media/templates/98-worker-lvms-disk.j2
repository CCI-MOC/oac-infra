apiVersion: machineconfiguration.openshift.io/v1
kind: MachineConfig
metadata:
  labels:
    machineconfiguration.openshift.io/role: worker
  name: 98-worker-lvms-disk
spec:
  config:
    ignition:
      version: 3.2.0
    storage:
      files:
        - path: /usr/local/bin/lvms-disk.sh
          mode: 0755
          overwrite: true
          contents:
            source: data:text/plain;charset=utf-8;base64,{{ lookup('template', 'lvms-disk.sh.j2') | b64encode }}
    systemd:
      units:
        - name: lvms-disk.service
          enabled: true
          contents: |
            [Unit]
            Description=Set up and unlock this worker's LVM Storage disk
            DefaultDependencies=no
            # Tang is reached over the network. On first boot,
            # ovs-configuration moves the node's address onto br-ex after the
            # network is first online, so wait for that too.
            Wants=network-online.target
            After=network-online.target ovs-configuration.service
            Before=kubelet.service

            [Service]
            Type=oneshot
            RemainAfterExit=yes
            ExecStart=/usr/local/bin/lvms-disk.sh

            [Install]
            WantedBy=multi-user.target
            RequiredBy=kubelet.service
