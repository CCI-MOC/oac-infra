apiVersion: v1
baseDomain: {{ base_domain }}
compute:
- name: worker
  replicas: {{ workers | length }}
controlPlane:
  name: master
  replicas: 3
networking:
  clusterNetwork:
  - cidr: {{ cluster_network }}
    hostPrefix: 23
  machineNetwork:
  - cidr: {{ machine_network }}
  networkType: OVNKubernetes
  serviceNetwork:
  - {{ svc_network }}
fips: {{ fips_enabled }}
metadata:
  name: {{ cluster_domain_name|default(cluster_name) }}
pullSecret: '{{ pull_secret | to_json if pull_secret is mapping else pull_secret }}'
sshKey: '{{ ssh_public_key }}'
platform:
  baremetal:
    apiVIPs:
      - {{ api_ip }}
    ingressVIPs:
      - {{ ingress_ip }}
    hosts:
      - name: {{ master1_hostname }}
        role: master
      - name: {{ master2_hostname }}
        role: master
      - name: {{ master3_hostname }}
        role: master
{% for worker in workers %}
      - name: {{ worker.hostname }}
        role: worker
{% endfor %}
