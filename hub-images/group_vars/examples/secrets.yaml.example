---
# Download your pull secret from https://console.redhat.com/openshift/downloads
# and save it to credentials/<cluster-name>/pull-secret.json. The credentials/
# directory is gitignored — do not commit pull secrets.
pull_secret: >-
  {{ lookup("ansible.builtin.file", [playbook_dir, "credentials", "<cluster-name>", "pull-secret.json"]|join("/")) }}
